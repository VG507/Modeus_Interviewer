# PostgreSQL is the main database (see README). SQLite works for a quick start:
# DATABASE_URL=sqlite:///./.work/modeus.db
DATABASE_URL=postgresql+psycopg://modeus:modeus@localhost/modeus
APP_ORIGIN=http://localhost:5173
# HTTPS origins automatically enable Secure cookies.
COOKIE_SECURE=false
SESSION_HOURS=12
# Exact OpenAI-compatible API root, including /v1 when required.
# The team runs gpt-oss-120b through token-shop; put your own key in LLM_API_KEY.
LLM_BASE_URL=https://token-shop.online/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
# Optional. For local Ollama with Qwen3, use none to disable thinking.
LLM_REASONING_EFFORT=
# Leave empty to use the provider default. Claude models have no seed; for local Ollama use e.g. LLM_SEED=42.
LLM_TEMPERATURE=0
LLM_SEED=
# Accepted model answers are stored, so the same request always gets the same answer.
LLM_CACHE=true
# Card search by meaning: an OpenAI-compatible /embeddings root, local Ollama by default
# (run `ollama pull bge-m3` once). Empty EMBEDDING_BASE_URL leaves search by words only.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=20
HH_USER_AGENT=
HH_ACCESS_TOKEN=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_AREAS=113
HH_WEEKLY_ENABLED=true
TRUDVSEM_COLLECTION_ENABLED=true
ESCO_COLLECTION_ENABLED=true
ESCO_VERSION=v1.2.0
# Optional token for reading public GitHub data.
GITHUB_TOKEN=
DOCUMENTATION_WEEKLY_ENABLED=true
# Include Hacker News candidates when collecting a profession from the editor interface.
HN_COLLECTION_ENABLED=true
OPENALEX_API_KEY=
# Telegram bot: token from @BotFather. Polling starts together with the backend.
TELEGRAM_BOT_TOKEN=
# Voice answers in Telegram: `pip install faster-whisper`, then a model name, e.g. large-v3-turbo.
# The model (~1.6 GB) downloads on the first voice message. Empty keeps voice off.
SPEECH_MODEL=
SPEECH_LANGUAGE=ru
# true lets anyone who opens the bot start interviews without an invite.
TELEGRAM_OPEN_SIGNUP=false
# MAX pilot: long polling starts with the backend when the token is set.
MAX_BOT_TOKEN=
# PEM bundle with the official MAX CA certificates, if absent from the system trust store.
MAX_CA_FILE=
